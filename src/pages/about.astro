---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SHOW_URL } from "../data/brands";
---

<BaseLayout>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-i18n="about.eyebrow">關於 Storys</span>
      <h1 class="page-head__title" data-i18n="about.titleZh">在 Storys Map 上，留下你的座標。</h1>
      <p class="page-head__alt" data-i18n="about.title">Make it on the Storys Map.</p>
    </div>
  </section>

  <section class="prose">
    <div class="wrap">
      <p data-i18n="about.body">
        Storys Podcast（原 創業之聲）紀錄每一位創辦人從第一步到每一步的旅程。
        這張地圖讓我們的聽眾走進這些品牌——支持那些勇敢起步的人，把每一段故事帶回到他們親手蓋起的場域。
      </p>

      <h2>Visual Identity</h2>
      <p>Storys 的視覺從台灣的森林與晨霧汲取靈感——深綠、奶油色、與一抹明亮的橘。</p>
      <ul class="palette">
        <li><span style="background:#162114"></span>Deep Forest · #162114</li>
        <li><span style="background:#324425"></span>Forest · #324425</li>
        <li><span style="background:#c7d0b2"></span>Sage · #c7d0b2</li>
        <li><span style="background:#f6f8ee; border:1px solid #d8dec5"></span>Cream · #f6f8ee</li>
        <li><span style="background:#f06d2d"></span>Orange · #f06d2d</li>
        <li><span style="background:#f0a92d"></span>Golden · #f0a92d</li>
      </ul>

      <div class="prose__cta">
        <a class="btn btn--accent" href={SHOW_URL} target="_blank" rel="noreferrer" data-i18n="about.cta">收聽 Storys Podcast</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: 60px 0 40px; text-align: center; border-bottom: 1px solid var(--c-line); }
  .page-head__title {
    margin: 8px 0 6px;
    font-family: var(--font-zh);
    font-weight: 900;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.01em;
  }
  .page-head__alt {
    font-family: var(--font-en);
    font-style: italic;
    color: var(--c-muted);
    font-size: 16px;
    margin-bottom: 0;
  }

  .prose { padding: 60px 0 80px; }
  .prose .wrap { max-width: 720px; }
  .prose p { font-size: 17px; line-height: 1.75; color: var(--c-forest); margin: 16px 0; }
  .prose h2 {
    margin: 48px 0 16px;
    font-family: var(--font-zh);
    font-weight: 900;
    font-size: 26px;
  }
  html[lang="en"] .prose h2 { font-family: var(--font-en); font-style: italic; }
  .palette { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .palette li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-en);
    font-size: 12px;
    font-weight: 600;
    color: var(--c-muted);
  }
  .palette span {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .prose__cta { margin-top: 36px; }
</style>
