---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-i18n="nav.contact">聯絡</span>
      <h1 class="page-head__title" data-i18n="contact.title">聯絡 Storys</h1>
      <p class="page-head__sub" data-i18n="contact.sub">想合作、贊助、加入嘉賓名單？來信告訴我們。</p>
    </div>
  </section>

  <section class="forms">
    <div class="wrap forms__grid">
      <article class="form-card">
        <h2 class="form-card__title" data-i18n="contact.general.title">一般聯絡</h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/contact?sent=1"
          class="form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="netlify-honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <label class="field">
            <span data-i18n="contact.field.name">你的名字</span>
            <input type="text" name="name" required />
          </label>
          <label class="field">
            <span data-i18n="contact.field.email">Email</span>
            <input type="email" name="email" required />
          </label>
          <label class="field">
            <span data-i18n="contact.field.message">訊息</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button class="btn btn--accent" type="submit" data-i18n="contact.submit">送出</button>
        </form>
      </article>

      <article class="form-card form-card--sponsor">
        <h2 class="form-card__title" data-i18n="contact.sponsor.title">贊助 / 業配合作</h2>
        <form
          name="sponsor"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/contact?sent=1"
          class="form"
        >
          <input type="hidden" name="form-name" value="sponsor" />
          <p class="netlify-honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <label class="field">
            <span data-i18n="contact.field.name">你的名字</span>
            <input type="text" name="name" required />
          </label>
          <label class="field">
            <span data-i18n="contact.field.email">Email</span>
            <input type="email" name="email" required />
          </label>
          <label class="field">
            <span data-i18n="contact.field.company">公司 / 品牌</span>
            <input type="text" name="company" required />
          </label>
          <label class="field">
            <span data-i18n="contact.field.budget">預估預算</span>
            <input type="text" name="budget" placeholder="NTD" />
          </label>
          <label class="field">
            <span data-i18n="contact.field.window">理想時程</span>
            <input type="text" name="window" />
          </label>
          <label class="field">
            <span data-i18n="contact.field.message">訊息</span>
            <textarea name="message" rows="4"></textarea>
          </label>
          <button class="btn btn--accent" type="submit" data-i18n="contact.submit">送出</button>
        </form>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  // Show a friendly inline confirmation when ?sent=1 is in the URL.
  if (typeof window !== "undefined" && new URL(window.location.href).searchParams.get("sent") === "1") {
    const head = document.querySelector(".page-head .wrap");
    if (head) {
      const note = document.createElement("p");
      note.className = "page-head__success";
      note.dataset.i18n = "contact.success";
      note.textContent = "已收到，感謝你的訊息。我們會盡快回覆。";
      head.appendChild(note);
    }
  }
</script>

<style>
  .page-head { padding: 60px 0 40px; text-align: center; border-bottom: 1px solid var(--c-line); }
  .page-head__title {
    margin: 8px 0 12px;
    font-family: var(--font-zh);
    font-weight: 900;
    font-size: clamp(36px, 6vw, 56px);
    letter-spacing: -0.01em;
  }
  .page-head__sub { color: var(--c-muted); font-size: 16px; }
  :global(.page-head__success) {
    margin-top: 18px;
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--c-orange);
    color: var(--c-cream);
    font-weight: 700;
    font-size: 13px;
  }

  .forms { padding: 60px 0 80px; }
  .forms__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  @media (max-width: 900px) { .forms__grid { grid-template-columns: 1fr; } }

  .form-card {
    background: white;
    border: 1px solid var(--c-line);
    border-radius: 16px;
    padding: 32px;
  }
  .form-card--sponsor { background: #fbfaf2; }
  .form-card__title {
    margin: 0 0 24px;
    font-family: var(--font-zh);
    font-weight: 900;
    font-size: 22px;
  }

  .form { display: flex; flex-direction: column; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--c-forest);
  }
  .field input, .field textarea {
    border: 1px solid var(--c-line);
    border-radius: 10px;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 15px;
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field input:focus, .field textarea:focus {
    outline: none;
    border-color: var(--c-orange);
    box-shadow: 0 0 0 3px rgba(240, 109, 45, 0.18);
  }
  .form .btn { align-self: flex-start; margin-top: 8px; }
</style>
