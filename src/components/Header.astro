---
import LanguageToggle from "./LanguageToggle.astro";
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-mark" href="/" aria-label="Storys">
      <img src="/brand/Logo_STORYS_logotype.svg" alt="STORYS" />
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/map" data-i18n="nav.map">地圖</a>
      <a href="/episodes" data-i18n="nav.episodes">節目</a>
      <a href="/team" data-i18n="nav.team">團隊</a>
      <a href="/about" data-i18n="nav.about">關於</a>
      <a href="/contact" data-i18n="nav.contact">聯絡</a>
    </nav>
    <LanguageToggle />
  </div>
</header>

<style>
  .site-header {
    padding: 20px 0;
    border-bottom: 1px solid var(--c-line);
    background: rgba(246, 248, 238, 0.88);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .site-mark img { height: 24px; width: auto; display: block; }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--c-forest);
    transition: color 0.2s var(--ease);
  }
  .site-nav a:hover { color: var(--c-orange); }

  @media (max-width: 720px) {
    .site-nav { display: none; }
  }
</style>
